#!/usr/bin/env bash
# --- Run lint ---
echo "Running lint..."
LINT_OUTPUT=$(npm run lint 2>&1)
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "">&2
  echo "❌ Lint failed. Fix the following errors before pushing:">&2
  echo "">&2
  echo "$LINT_OUTPUT">&2
  echo "">&2
  exit 1
fi
# --- Run Build ---
echo "Running Build..."
npm run build
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "Build has failed, fix errors before committing.">&2
  exit 1
fi

echo "Pre-push checks passed."

