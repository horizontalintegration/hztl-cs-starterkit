#!/usr/bin/env bash
# --- Run lint ---
echo "Running lint..."
npm run lint
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Lint failed. Fix the errors above before pushing."
  exit 1
fi
# --- Run Build ---
echo "Running build..."
npm run build
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Build failed. Fix the errors above before pushing."
  exit 1
fi

echo "Pre-push checks passed."

