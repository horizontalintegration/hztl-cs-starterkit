{
  "name": "srpnet",
  "version": "1.0.0",
  "private": true,
  "description": "SRPNET Repo",
  "scripts": {
    "tsgen": "csdx tsgen -a srpnet-delivery-token -o \"./.generated/index.ts\" -p \"I\" --branch=main --no-doc --include-system-fields --include-editable-tags",
    "scaffold": "tsx scripts/scaffold-component.ts",
    "gen-config": "tsx scripts/generate-component-mapper.ts",
    "fetch-languages": "tsx --require dotenv-flow/config scripts/fetch-language.ts",
    "gen-config:watch": "tsx scripts/generate-component-mapper.ts --watch",
    "gen-theme": "tsx --require dotenv-flow/config scripts/generate-theme-css.ts",
    "next:build": "next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "dev": "cross-env NODE_ENV=development npm-run-all --serial fetch-languages tsgen gen-theme --parallel gen-config:watch next:dev",
    "build": "cross-env NODE_ENV=production npm-run-all --serial fetch-languages gen-theme gen-config next:build",
    "start": "cross-env-shell NODE_ENV=production npm-run-all --serial fetch-languages gen-theme gen-config next:build next:start",
    "lint": "eslint .",
    "export-content": "tsx scripts/export-content.ts",
    "import-content": "tsx scripts/import-content.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@contentstack/delivery-sdk": "^4.11.0",
    "@contentstack/json-rte-serializer": "^3.0.3",
    "@contentstack/live-preview-utils": "^4.2.1",
    "@contentstack/management": "^1.27.3",
    "@contentstack/utils": "^1.4.4",
    "@timbenniks/contentstack-endpoints": "^2.1.0",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "next": "^16.1.6",
    "postcss": "^8.4.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-singleton-hook": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.0",
    "cross-env": "~7.0.3",
    "dotenv": "^16.0.3",
    "dotenv-cli": "^11.0.0",
    "dotenv-flow": "^4.1.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^13.1.5",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "npm-run-all": "~4.1.5",
    "prettier": "^3.3.2",
    "react-syntax-highlighter": "^15.5.0",
    "tailwind-config": "^0.1.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "next": "$next"
  }
}
